# Server-side image resize ceiling (px on the long edge).
# 800 ≈ 4s/request. 1200 ≈ 10s. Raise with awareness of your timeout budget.
NEUTROFUSE_MAX_LONG_EDGE=800

# Max bytes per uploaded image (default 12MB)
NEUTROFUSE_MAX_UPLOAD_BYTES=12582912

# Comma-separated allowed CORS origins.
# Set to your frontend URL in production, e.g. https://neutrofuse.vercel.app
# Leave as * for local development.
NEUTROFUSE_ALLOWED_ORIGINS=*
